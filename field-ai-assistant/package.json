{
  "name": "field-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/src/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test server/tests/*.test.ts client/tests/*.test.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/src/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0"
  }
}
